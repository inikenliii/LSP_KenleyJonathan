as="geometry"/></mxCell><mxCell id="c64" value="renter_id (1 : 0..*)" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="c3" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c65" value="rental_id (1 : 0..*)" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="c31" target="c51"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c66" value="admin_id (1 : 0..*)" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="c3" target="c51"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c67" value="verified_by_id (0..1 : 0..*)" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="c3" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b&gt;Tipe enum&lt;/b&gt;&lt;br&gt;Role: ADMIN, RENTER&lt;br&gt;VerificationStatus: PENDING, ACCEPTED, REJECTED&lt;br&gt;GarageType: BICYCLE, CAR, ELECTRIC_CAR&lt;br&gt;GarageStatus: AVAILABLE, USED&lt;br&gt;VehicleType: SEPEDA, SEPEDA_MOTOR, MOBIL, MOBIL_LISTRIK&lt;br&gt;RentalType: HARIAN, BULANAN" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="560" height="190" as="geometry"/></mxCell><mxCell id="c69" value="&lt;b&gt;Indeks&lt;/b&gt;&lt;br&gt;UQ users_nik_key: users(nik)&lt;br&gt;UQ users_email_key: users(email)&lt;br&gt;users_role_verification_status_idx: users(role, verification_status)&lt;br&gt;IDX_session_expire: session(expire)&lt;br&gt;garages_type_status_idx: garages(type, status)&lt;br&gt;rentals_renter_id_idx: rentals(renter_id)&lt;br&gt;rentals_garage_id_end_date_idx: rentals(garage_id, end_date)&lt;br&gt;rental_extensions_rental_id_idx: rental_extensions(rental_id)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="230" width="440" height="200" as="geometry"/></mxCell><mxCell id="c70" value="&lt;b&gt;Catatan&lt;/b&gt;&lt;br&gt;Tabel session tidak punya foreign key: kolom sess menyimpan userId sebagai JSON dan kolom sid menyimpan hash SHA-256 dari token cookie.&lt;br&gt;Harga bulanan tidak disimpan; selalu 25 x daily_price.&lt;br&gt;&lt;b&gt;Legenda&lt;/b&gt;: PK kunci utama, FK kunci asing, UQ unik. Ujung garis relasi memakai notasi kaki gagak: sisi induk satu (wajib atau nol-satu), sisi anak nol atau banyak." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="480" width="520" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>

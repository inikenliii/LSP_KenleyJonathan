{% extends "layout.njk" %}

{% block title %}Verifikasi Pendaftar - {{ appName }}{% endblock %}

{% block content %}
<h1>Verifikasi Pendaftar</h1>
<p>Cocokkan NIK dan nama lengkap dengan KTP pendaftar sebelum menerima pendaftaran.</p>

{% if registrants.length == 0 %}
<div class="card">
  <p>Tidak ada pendaftar yang menunggu verifikasi.</p>
</div>
{% else %}
<div class="table-wrapper">
  <table class="table">
    <caption>Pendaftar yang menunggu verifikasi</caption>
    <thead>
      <tr>
        <th scope="col">Nama Lengkap</th>
        <th scope="col">NIK</th>
        <th scope="col">Nomor Telepon</th>
        <th scope="col">Email</th>
        <th scope="col">Tanggal Daftar</th>
        <th scope="col">Status</th>
        <th scope="col">Aksi</th>
      </tr>
    </thead>
    <tbody>
      {% for registrant in registrants %}
      <tr data-user-id="{{ registrant.id }}">
        <td>{{ registrant.fullName }}</td>
        <td>{{ registrant.nik }}</td>
        <td>{{ registrant.phone }}</td>
        <td>{{ registrant.email }}</td>
        <td>{{ registrant.createdAt | tanggal }}</td>
        <td><span class="badge badge--pending">Menunggu verifikasi</span></td>
        <td></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}
{% endblock %}

{% extends "layout.njk" %}

{% block title %}Verifikasi Pendaftar - {{ appName }}{% endblock %}

{% block content %}
<h1>Verifikasi Pendaftar</h1>
<p>Cocokkan NIK dan nama lengkap dengan KTP pendaftar sebelum menerima pendaftaran.</p>

{% if registrants.length == 0 %}
<div class="card">
  <p>Tidak ada pendaftar yang menunggu verifikasi.</p>
</div>
{% else %}
<div class="table-wrapper">
  <table class="table">
    <caption>Pendaftar yang menunggu verifikasi</caption>
    <thead>
      <tr>
        <th scope="col">Nama Lengkap</th>
        <th scope="col">NIK</th>
        <th scope="col">Nomor Telepon</th>
        <th scope="col">Email</th>
        <th scope="col">Tanggal Daftar</th>
        <th scope="col">Status</th>
        <th scope="col">Aksi</th>
      </tr>
    </thead>
    <tbody>
      {% for registrant in registrants %}
      <tr data-user-id="{{ registrant.id }}">
        <td>{{ registrant.fullName }}</td>
        <td>{{ registrant.nik }}</td>
        <td>{{ registrant.phone }}</td>
        <td>{{ registrant.email }}</td>
        <td>{{ registrant.createdAt | tanggal }}</td>
        <td><span class="badge badge--pending">Menunggu verifikasi</span></td>
        <td>
          {% if rowError and rowError.userId == (registrant.id | string) %}
          <p class="field-error" role="alert">{{ rowError.message }}</p>
          {% endif %}
          <form class="inline-form" method="post" action="/admin/pendaftar/{{ registrant.id }}/keputusan">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="hidden" name="decision" value="ACCEPT">
            <input id="ktp-{{ registrant.id }}" name="ktpValidated" type="checkbox" value="on" required>
            <label for="ktp-{{ registrant.id }}">KTP sudah divalidasi</label>
            <button class="btn btn--primary" type="submit">Terima</button>
          </form>
          <form class="inline-form" method="post" action="/admin/pendaftar/{{ registrant.id }}/keputusan">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="hidden" name="decision" value="REJECT">
            <button class="btn btn--danger" type="submit">Tolak</button>
          </form>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}
{% endblock %}

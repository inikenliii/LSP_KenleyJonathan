{% extends "layout.njk" %}

{% block title %}Kelola Garasi - {{ appName }}{% endblock %}

{% block content %}
<h1>Kelola Garasi</h1>

<h2>Harga per Tipe Garasi</h2>
<div class="table-wrapper">
  <table class="table">
    <caption>Harga dan kuota per tipe garasi</caption>
    <thead>
      <tr>
        <th scope="col">Tipe</th>
        <th scope="col">Awalan ID</th>
        <th scope="col">Harga Harian</th>
        <th scope="col">Harga Bulanan</th>
        <th scope="col">Harga per kWh</th>
        <th scope="col">Jumlah Garasi</th>
        <th scope="col">Sisa Kuota</th>
      </tr>
    </thead>
    <tbody>
      {% for config in configs %}
      <tr data-garage-type="{{ config.code }}">
        <td>{{ config.label }}</td>
        <td>{{ config.prefix }}</td>
        <td>{% if config.priceIsSet %}{{ config.dailyPrice | rupiah }}{% else %}Belum diatur{% endif %}</td>
        <td>{% if config.priceIsSet %}{{ config.monthlyPrice | rupiah }}{% else %}Belum diatur{% endif %}</td>
        <td>
          {% if not config.usesKwhPrice %}-
          {% elif config.pricePerKwh !== null %}{{ config.pricePerKwh | rupiah }}
          {% else %}Belum diatur{% endif %}
        </td>
        <td>{{ config.totalCreated }}</td>
        <td>{{ config.remainingQuota }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<h2>Buat Garasi Berkelompok</h2>

{% if errors and (errors | length) %}
<div class="error-summary" role="alert">
  <ul>
    {% for field, message in errors %}
    <li>{{ message }}</li>
    {% endfor %}
  </ul>
</div>
{% endif %}

<form class="form" method="post" action="/admin/garasi" novalidate>
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">

  <div class="form-field">
    <label for="type">Tipe garasi</label>
    <select id="type" name="type" required
            aria-describedby="type-error"{% if errors.type %} aria-invalid="true"{% endif %}>
      <option value="" disabled{% if not values.type %} selected{% endif %}>Pilih tipe</option>
      {% for config in configs %}
      <option value="{{ config.code }}"{% if values.type == config.code %} selected{% endif %}>{{ config.label }}</option>
      {% endfor %}
    </select>
    <p class="field-error" id="type-error">{{ errors.type }}</p>
  </div>

  <div class="form-field">
    <label for="quantity">Jumlah garasi (1-999)</label>
    <input id="quantity" name="quantity" type="number" min="1" max="999" required
           value="{{ values.quantity }}"
           aria-describedby="quantity-error"{% if errors.quantity %} aria-invalid="true"{% endif %}>
    <p class="field-error" id="quantity-error">{{ errors.quantity }}</p>
  </div>

  <div class="form-field">
    <label for="dailyPrice">Harga sewa harian (Rp)</label>
    <input id="dailyPrice" name="dailyPrice" type="number" min="1" max="10000000" required
           value="{{ values.dailyPrice }}"
           aria-describedby="dailyPrice-hint dailyPrice-error"{% if errors.dailyPrice %} aria-invalid="true"{% endif %}>
    <p class="field-hint" id="dailyPrice-hint">Harga bulanan otomatis = 25 x harga harian. Harga ini berlaku untuk semua garasi bertipe sama.</p>
    <p class="field-error" id="dailyPrice-error">{{ errors.dailyPrice }}</p>
  </div>

  <div class="form-field">
    <label for="pricePerKwh">Harga isi listrik per kWh (Rp)</label>
    <input id="pricePerKwh" name="pricePerKwh" type="number" min="1" max="1000000"
           value="{{ values.pricePerKwh }}"
           aria-describedby="pricePerKwh-hint pricePerKwh-error"{% if errors.pricePerKwh %} aria-invalid="true"{% endif %}>
    <p class="field-hint" id="pricePerKwh-hint">Wajib untuk Mobil Listrik; diabaikan untuk tipe lain.</p>
    <p class="field-error" id="pricePerKwh-error">{{ errors.pricePerKwh }}</p>
  </div>

  <button class="btn btn--primary" type="submit">Buat Garasi</button>
</form>

<h2>Daftar Garasi</h2>
<p>Total {{ garages.total }} garasi</p>
{% if garages.items | length %}
<div class="table-wrapper">
  <table class="table">
    <caption>Daftar garasi</caption>
    <thead>
      <tr>
        <th scope="col">ID</th>
        <th scope="col">Tipe</th>
        <th scope="col">Harga Harian</th>
        <th scope="col">Harga Bulanan</th>
        <th scope="col">Harga per kWh</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody>
      {% for garage in garages.items %}
      <tr data-garage-id="{{ garage.id }}">
        <td>{{ garage.id }}</td>
        <td>{{ garage.typeLabel }}</td>
        <td>{{ garage.dailyPrice | rupiah }}</td>
        <td>{{ garage.monthlyPrice | rupiah }}</td>
        <td>{% if garage.usesKwhPrice %}{{ garage.pricePerKwh | rupiah }}{% else %}-{% endif %}</td>
        <td>
          {% if garage.statusCode == 'AVAILABLE' %}<span class="badge badge--available">{{ garage.statusLabel }}</span>
          {% else %}<span class="badge badge--used">{{ garage.statusLabel }}</span>{% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% else %}
<div class="card"><p>Belum ada garasi.</p></div>
{% endif %}
{% endblock %}

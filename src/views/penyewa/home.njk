{% extends "layout.njk" %}

{% block title %}Beranda Penyewa - {{ appName }}{% endblock %}

{% block content %}
<h1>Beranda Penyewa</h1>
<p>Selamat datang, {{ user.fullName }}.</p>

<div class="card">
  <h2>Data Akun</h2>
  <dl>
    <dt>Nama Lengkap</dt>
    <dd>{{ user.fullName }}</dd>
    <dt>NIK</dt>
    <dd>{{ user.nik }}</dd>
    <dt>Email</dt>
    <dd>{{ user.email }}</dd>
    <dt>Nomor Telepon</dt>
    <dd>{{ user.phone }}</dd>
    <dt>Status</dt>
    <dd><span class="badge badge--available">{{ user.statusLabel }}</span></dd>
  </dl>
</div>

<p>Akun Anda sudah diverifikasi admin.</p>
{% endblock %}

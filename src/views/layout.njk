<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ appName }}{% endblock %}</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a class="site-title" href="/">{{ appName }}</a>
      <nav class="site-nav" aria-label="Navigasi utama">
        <ul>
          {% if currentUser %}
          {% if currentUser.role == 'ADMIN' %}
          <li><a href="/admin">Dasbor</a></li>
          <li><a href="/admin/pendaftar">Pendaftar</a></li>
          {% else %}
          <li><a href="/penyewa">Beranda Penyewa</a></li>
          {% endif %}
          <li class="nav-user">Masuk sebagai {{ currentUser.fullName }} ({{ currentUser.roleLabel }})</li>
          <li>
            <form method="post" action="/logout">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}">
              <button class="btn btn--secondary" type="submit">Keluar</button>
            </form>
          </li>
          {% else %}
          <li><a href="/">Beranda</a></li>
          <li><a href="/register">Daftar</a></li>
          <li><a href="/login">Masuk</a></li>
          {% endif %}
        </ul>
      </nav>
    </div>
  </header>

  {% if flash %}
  <div class="container">
    <div class="alert alert--{{ flash.type }}" role="{{ 'alert' if flash.type == 'error' else 'status' }}">{{ flash.message }}</div>
  </div>
  {% endif %}

  <main class="container">
    {% block content %}{% endblock %}
  </main>

  <footer class="container site-footer">
    <p>Ujian Praktik LSP Pemrogram - Aplikasi Penyewaan Garasi</p>
  </footer>
</body>
</html>

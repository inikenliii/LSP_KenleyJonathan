{
  "name": "aplikasi-penyewaan-garasi",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi web penyewaan garasi kendaraan (Ujian Praktik LSP Pemrogram)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "setup": "prisma migrate deploy && prisma generate && prisma db seed",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.e2e.test.js",
    "test": "npm run test:e2e"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "connect-pg-simple": "10.0.0",
    "csrf-sync": "4.2.1",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "nunjucks": "3.2.4",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "zod": "4.6.7"
  }
}

{
  "name": "aplikasi-penyewaan-garasi",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi web penyewaan garasi kendaraan (Ujian Praktik LSP Pemrogram)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next build && next start",
    "test": "vitest run",
    "docs": "typedoc --options typedoc.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "setup": "prisma migrate deploy && prisma generate && prisma db seed"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.77.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}

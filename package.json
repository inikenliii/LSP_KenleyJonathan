{
  "name": "aplikasi-penyewaan-garasi",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi web penyewaan garasi kendaraan (Ujian Praktik LSP Pemrogram)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "setup": "prisma migrate deploy && prisma generate && prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.10",
    "prisma": "7.10.1",
    "zod": "4.6.7"
  }
}

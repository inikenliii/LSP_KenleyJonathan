// Skema database aplikasi penyewaan garasi (PostgreSQL).
// URL koneksi tidak ditulis di sini; lihat prisma.config.ts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Peran pengguna sistem.
enum Role {
  ADMIN
  RENTER
}

// Status verifikasi pendaftaran penyewa oleh admin.
enum VerificationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Akun pengguna (Admin dan Penyewa). Email disimpan huruf kecil.
model User {
  id                 Int                @id @default(autoincrement())
  // Unik: satu NIK hanya boleh dimiliki satu akun penyewa.
  nik                String?            @unique @db.VarChar(16) // kosong hanya untuk akun Admin hasil seed
  fullName           String             @map("full_name") @db.VarChar(100)
  phone              String?            @db.VarChar(20)
  // Unik: login mencari akun lewat email dan satu email hanya boleh dimiliki satu akun.
  email              String             @unique @db.VarChar(254)
  passwordHash       String             @map("password_hash")
  role               Role               @default(RENTER)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  verifiedById       Int?               @map("verified_by_id")
  verifiedBy         User?              @relation("UserVerifications", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedUsers      User[]             @relation("UserVerifications")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  rentals            Rental[]
  // Perpanjangan sewa yang disimpan oleh Admin ini.
  rentalExtensions   RentalExtension[]

  // Daftar pendaftar selalu difilter menurut peran dan status verifikasi.
  @@index([role, verificationStatus])
  @@map("users")
}

// Tabel sesi login aplikasi: sid berisi hash SHA-256 dari token cookie,
// sess berisi userId, dan expire adalah waktu kedaluwarsa sesi.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// Tipe garasi yang disewakan.
enum GarageType {
  BICYCLE
  CAR
  ELECTRIC_CAR
}

// Status ketersediaan satu garasi.
enum GarageStatus {
  AVAILABLE
  USED
}

// Konfigurasi per tipe garasi: harga, harga per kWh, dan penghitung nomor ID.
// Satu baris per tipe; harga harian berlaku untuk semua garasi bertipe sama.
// Harga bulanan tidak disimpan karena selalu 25 x harga harian.
model GarageTypeConfig {
  type        GarageType @id
  dailyPrice  Int        @default(0) @map("daily_price") // rupiah utuh; 0 berarti belum diatur
  pricePerKwh Int?       @map("price_per_kwh") // hanya untuk ELECTRIC_CAR
  lastNumber  Int        @default(0) @map("last_number") // penghitung ID per tipe, 0 sampai 999
  updatedAt   DateTime   @updatedAt @map("updated_at")
  garages     Garage[]

  @@map("garage_type_configs")
}

// Satu garasi dengan ID seperti S001, C010, atau E999.
model Garage {
  id        String           @id @db.VarChar(4)
  type      GarageType
  status    GarageStatus     @default(AVAILABLE)
  config    GarageTypeConfig @relation(fields: [type], references: [type])
  createdAt DateTime         @default(now()) @map("created_at")
  rentals   Rental[]

  // Daftar garasi dan pemeriksaan ketersediaan selalu memfilter tipe dan status.
  @@index([type, status])
  @@map("garages")
}

// Tipe kendaraan yang disewakan garasinya.
enum VehicleType {
  SEPEDA
  SEPEDA_MOTOR
  MOBIL
  MOBIL_LISTRIK
}

// Jenis sewa: per hari atau per bulan.
enum RentalType {
  HARIAN
  BULANAN
}

// Satu transaksi sewa garasi oleh penyewa. Tanggal berupa tanggal saja (tanpa jam);
// harga disimpan sebagai salinan saat sewa dibuat agar perubahan harga tidak mengubah riwayat.
model Rental {
  id               Int               @id @default(autoincrement())
  renterId         Int               @map("renter_id")
  renter           User              @relation(fields: [renterId], references: [id])
  garageId         String            @map("garage_id") @db.VarChar(4)
  garage           Garage            @relation(fields: [garageId], references: [id])
  vehicleType      VehicleType       @map("vehicle_type")
  plateNumber      String?           @map("plate_number") @db.VarChar(12) // kosong untuk sepeda
  vehicleBrand     String            @map("vehicle_brand") @db.VarChar(50)
  vehicleModel     String            @map("vehicle_model") @db.VarChar(50)
  batteryKwh       Decimal?          @map("battery_kwh") @db.Decimal(5, 1) // hanya mobil listrik
  rentalType       RentalType        @map("rental_type")
  days             Int? // hanya sewa harian
  startDate        DateTime          @map("start_date") @db.Date
  endDate          DateTime          @map("end_date") @db.Date
  dailyPrice       Int               @map("daily_price") // salinan harga harian tipe garasi
  pricePerKwh      Int?              @map("price_per_kwh") // salinan harga per kWh, hanya bila baterai diisi penuh
  chargeCost       Int               @default(0) @map("charge_cost")
  totalCost        Int               @map("total_cost") // rupiah utuh
  paymentProofFile String            @map("payment_proof_file") @db.VarChar(64) // nama file saja
  createdAt        DateTime          @default(now()) @map("created_at")
  extensions       RentalExtension[]

  // Halaman Sewa Saya selalu memfilter sewa menurut penyewa.
  @@index([renterId])
  // Pelepasan garasi memeriksa sewa yang masih aktif per garasi menurut tanggal selesai.
  @@index([garageId, endDate])
  @@map("rentals")
}

// Satu perpanjangan sewa aktif oleh Admin. Sisa biaya = tambahan hari x salinan harga
// harian sewa tersebut; tanggal berakhir sewa dipindah ke tanggal berakhir baru.
model RentalExtension {
  id               Int      @id @default(autoincrement())
  rentalId         Int      @map("rental_id")
  rental           Rental   @relation(fields: [rentalId], references: [id])
  previousEndDate  DateTime @map("previous_end_date") @db.Date
  newEndDate       DateTime @map("new_end_date") @db.Date
  additionalDays   Int      @map("additional_days")
  dailyPrice       Int      @map("daily_price") // salinan harga harian dari sewa
  amount           Int // rupiah utuh
  paymentProofFile String   @map("payment_proof_file") @db.VarChar(64) // nama file hasil buatan server
  adminId          Int      @map("admin_id")
  admin            User     @relation(fields: [adminId], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  // Riwayat perpanjangan dan jumlah laporan selalu dicari per sewa.
  @@index([rentalId])
  @@map("rental_extensions")
}

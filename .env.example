# Contoh konfigurasi. Salin menjadi .env lalu isi nilai sebenarnya.
# Berkas .env asli TIDAK BOLEH di-commit. Nama database uji harus berakhiran _test.

# Koneksi database utama PostgreSQL
DATABASE_URL="postgresql://postgres:GANTI_PASSWORD_POSTGRES@localhost:5432/garage_rental"

# Koneksi database khusus pengujian (nama harus berakhiran _test)
TEST_DATABASE_URL="postgresql://postgres:GANTI_PASSWORD_POSTGRES@localhost:5432/garage_rental_test"

# Kunci penanda sesi login, minimal 32 karakter (contoh pembuatan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=ganti-dengan-64-karakter-hex-acak

# Email akun Admin yang dibuat oleh seed
ADMIN_EMAIL=admin@garasi.test

# Password akun Admin (8 sampai 72 karakter)
ADMIN_PASSWORD=ganti-password-admin

# Nama lengkap akun Admin
ADMIN_NAME=Administrator

# Port server web
PORT=3000

# Mode aplikasi: development, production, atau test
NODE_ENV=development

# Batas percobaan login/daftar per 15 menit untuk satu alamat IP
AUTH_RATE_LIMIT_MAX=10
